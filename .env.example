# Copy this file to .env and replace the local-only placeholder values.
POSTGRES_DB=paperlens
POSTGRES_USER=paperlens
POSTGRES_PASSWORD=replace-with-a-local-only-password
# Used by a FastAPI process running directly on Windows. The Compose backend
# overrides this with the Docker-network address db:5432.
PAPERLENS_DATABASE_URL=postgresql+psycopg://paperlens:replace-with-a-local-only-password@127.0.0.1:5432/paperlens
PAPERLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Absolute path to the existing Phase 1–8 artifacts/data directory.
PAPERLENS_ARTIFACT_DIR=C:/path/to/PaperLens-AI/artifacts/data

# Absolute path to the Hugging Face hub cache containing
# models--sentence-transformers--all-MiniLM-L6-v2.
HUGGINGFACE_HUB_DIR=C:/path/to/huggingface/hub
