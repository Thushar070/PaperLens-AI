# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments and downloaded resources
.venv/
venv/
ENV/
/.phase1_dependencies/
/.phase1_cache/
/.phase2_resources/
/.phase2_venv/
/.phase9_tmp/

# Local credentials and environment files; keep the placeholder template
**/.env
**/.env.*
!/.env.example

# Datasets, generated outputs, and model artifacts
/datasets/
/data/
/artifacts/
**/*.arrow
**/*.parquet
**/*.csv
**/*.tsv
**/*.jsonl
**/*.npy
