**/*.weights
**/*.h5
**/*.zip
**/*.gz
**/*.tar
**/*.pdf
**/*.png
**/*.jpg
**/*.jpeg

# JavaScript dependencies and generated frontend output
**/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Build, coverage, and test output
build/
dist/
coverage/
playwright-report/
test-results/
*.egg-info/

# Logs, temporary files, and editor/OS state
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Markdown policy: only the root README is source-controlled
*.md
!/README.md
*.markdown
*.mdx
*.mdown
*.mkd
*.mkdn
*.mdwn
